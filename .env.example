# Application (Telegram chỉ gửi khi NODE_ENV=production)
NODE_ENV=development
# Ogma: LOG_JSON=true → log dạng JSON (Docker / aggregator). Mặc định dev = pretty, production = JSON trừ khi LOG_JSON=false
# LOG_JSON=

# App listen + Docker publish (cùng PORT cho host:container trong docker-compose)
PORT=3000

# Docker Compose — tên project (prefix network/volume). Không dùng key `name:` trong YAML
# (một số schema/IDE báo lỗi); chỉ cần biến này + deploy.sh đã source .env.
# https://docs.docker.com/compose/how-tos/project-name/
COMPOSE_PROJECT_NAME=stock-analysis

# Database (MySQL 8.4)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=stock_analysis
# Production: đặt DB_SYNCHRONIZE=true để đồng bộ schema (cột/enum) theo entity khi app chạy.
# DB_SYNCHRONIZE=false tắt hẳn (kể cả dev). Không set = dev sync, production không sync.
# DB_SYNCHRONIZE=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backtest: số ngày lịch không cho mở lại sau khi đóng lệnh giả lập (0 = thuật toán cũ, mặc định).
# Đặt 5 để gần cooldown mở vị thế thật (POSITION_REENTRY_COOLDOWN_DAYS).
# BACKTEST_REENTRY_COOLDOWN_DAYS=0

# Sync / queue (tùy chọn — chỉ tăng khi DB + API DNSE chịu tải)
# Trong phiên (T2–T6, ~9:30–14:45 VN): cron `*/7 9-14` chỉ sync **nến ngày hiện tại** + analyze (không overlap 7 ngày; đổi trong scanner.service.ts). Luôn gồm **VNINDEX** + **VN30** trước các mã watchlist active.
# Khuyến nghị tự động / Telegram MUA-BÁN / mở vị thế: chỉ sau đóng cửa (≥14:46 VN), tin 16:00 giữ nguyên.
# Số mã chạy song song: cron scanner sync, job SYNC_ALL / SCAN_ALL / ANALYZE_HISTORY_ALL
# SYNC_TICKERS_CONCURRENCY=4
# Worker BullMQ xử lý bao nhiêu job cùng lúc (mặc định 2)
# STOCK_QUEUE_CONCURRENCY=2

# Phái sinh (VN30): trong phiên T2–T6, cron mỗi 1 phút quét nến VN30 5m,
# lưu quyết định LONG/SHORT/NO_TRADE và gửi Telegram khi có quyết định mới đáng chú ý.
# DERIVATIVES_VN30_FIVE_MIN_SCAN=true
# DERIVATIVES_TELEGRAM_NOTIFY=true
# DERIVATIVES_TELEGRAM_NOTIFY_NO_TRADE=false

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Profile lọc thông báo: balanced (mặc định), strict, full
# TELEGRAM_NOTIFY_PROFILE=balanced
# Bật/tắt từng nhóm thông báo
# TELEGRAM_NOTIFY_ENABLE_STARTUP=false
# TELEGRAM_NOTIFY_ENABLE_RECOMMEND_SUMMARY=true
# TELEGRAM_NOTIFY_ENABLE_RECOMMEND_MANUAL=true
# TELEGRAM_NOTIFY_ENABLE_POSITION_CLOSE=true
# TELEGRAM_NOTIFY_ENABLE_POSITION_TRACK=true
# TELEGRAM_NOTIFY_ENABLE_BREAKOUT_INTRADAY=false
# TELEGRAM_NOTIFY_ENABLE_BREAKOUT_CLOSE_CONFIRM=true
# TELEGRAM_NOTIFY_ENABLE_SIGNAL_NOTIFY=false
# TELEGRAM_NOTIFY_ENABLE_STOCK_ALERT=false
# Daily cap theo nhóm
# MAX_RECOMMEND_MSG_PER_DAY=2
# MAX_POSITION_TRACK_MSG_PER_DAY=1
# MAX_BREAKOUT_CONFIRM_MSG_PER_DAY=20
# Ngưỡng chất lượng báo cáo vị thế
# TELEGRAM_TRACK_SIGNIFICANT_PNL_DELTA=2
# TELEGRAM_TRACK_NEAR_TARGET_PCT=2
# MUA trên Telegram: mặc định safe (ít nhiễu). all = mọi BUY/STRONG_BUY như trước
# TELEGRAM_BUY_NOTIFY_MODE=all
# Giới hạn dòng tin 16:00 / báo cáo 15:45 (tránh loãng)
# TELEGRAM_RECOMMEND_MAX_BUYS=8
# TELEGRAM_RECOMMEND_MAX_SELLS=8
# TELEGRAM_DAILY_MAX_STOCKS_PER_SIDE=10
# Break cản trong phiên: tin «đang mạnh» chỉ khi giá đóng (nến ngày đang hình thành) giữ trên cản 60 phiên
# liên tục đủ phút — mặc định 30 (tránh break 1 nhịp rồi cụt đầu). Tắt: TELEGRAM_INTRADAY_BREAKOUT_ENABLED=false
# TELEGRAM_INTRADAY_BREAKOUT_HOLD_MINUTES=30
# Sau sync 15:30: một tin «đóng cửa xác nhận break» nếu DB có RESISTANCE_BREAKOUT — tắt: TELEGRAM_BREAKOUT_CLOSE_CONFIRM=false
# TELEGRAM_BREAKOUT_CLOSE_CONFIRM=true
# INTRADAY_BREAKOUT_CONCURRENCY=4

# Auth (Admin login for web dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars

# DNSE LightSpeed API
# Không cần cấu hình — chart API miễn phí, không cần đăng nhập.
# Đăng ký tại https://developers.dnse.com.vn nếu cần trading API / intraday realtime.
# DNSE_USERNAME=your_dnse_email
# DNSE_PASSWORD=your_dnse_password
