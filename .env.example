# Application (Telegram chỉ gửi khi NODE_ENV=production)
NODE_ENV=development
# App listen + Docker publish (cùng PORT cho host:container trong docker-compose)
PORT=3000

# Docker Compose — tên project (prefix network/volume). Không dùng key `name:` trong YAML
# (một số schema/IDE báo lỗi); chỉ cần biến này + deploy.sh đã source .env.
# https://docs.docker.com/compose/how-tos/project-name/
COMPOSE_PROJECT_NAME=stock-analysis

# Database (MySQL 8.4)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=stock_analysis
# Production: đặt DB_SYNCHRONIZE=true để đồng bộ schema (cột/enum) theo entity khi app chạy.
# DB_SYNCHRONIZE=false tắt hẳn (kể cả dev). Không set = dev sync, production không sync.
# DB_SYNCHRONIZE=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Auth (Admin login for web dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars

# DNSE LightSpeed API
# Không cần cấu hình — chart API miễn phí, không cần đăng nhập.
# Đăng ký tại https://developers.dnse.com.vn nếu cần trading API / intraday realtime.
# DNSE_USERNAME=your_dnse_email
# DNSE_PASSWORD=your_dnse_password
